# Azure DevOps Personal Access Token (PAT)
#
# Get your PAT from: https://dev.azure.com/<your-org>/_usersSettings/tokens
# 1. Click "New Token"
# 2. Name: "claude-code-plugin"
# 3. Scopes: Work Items (Read)
# 4. Copy the token and paste below
#
# DO NOT commit the actual .env file — only .env.example

AZURE_DEVOPS_EXT_PAT=your-pat-token-here
AZDO_PAT=your-pat-token-here
